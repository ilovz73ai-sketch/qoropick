{
  "name": "qoropick-open",
  "private": true,
  "type": "module",
  "description": "qoropick's public parts: the Sealer page that locks your secret number, the offline verifier, and the rules library the app runs.",
  "scripts": {
    "dev": "vite --config sealer/vite.config.mts",
